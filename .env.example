# InvokeAI server (no trailing slash)
INVOKE_BASE_URL=http://127.0.0.1:9090

# Multi-user mode: Bearer JWT from POST /api/v1/auth/login → { "token": "..." }
# Single-user mode: leave empty
INVOKE_API_TOKEN=

# Optional alternate auth header (X-API-Key + Bearer) if token empty
INVOKE_API_KEY=

# Paths inside the container (map host dirs via Docker volumes)
INVOKE_OUTPUTS_DIR=/data/invoke-outputs
KEEP_DIR=/data/keepers
# FRIENDS_DIR=/data/keepers   # alias for KEEP_DIR (back-compat)
CONFIG_DIR=/data/config
# THUMBS_DIR=/data/config/thumbs   # optional override

# Prefer this subfolder under outputs when listing (default: images)
IMAGE_SUBDIR=images

PORT=8080
APP_TITLE=Invoke Library
KEEP_LABEL=Keepers

# Optional HTTP Basic Auth for this UI
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Compose host-side helpers (used by docker-compose.yml)
HOST_PORT=8091
INVOKE_OUTPUTS_HOST=./data/outputs
KEEP_HOST=./data/keepers
CONFIG_HOST=./data/config

# Min aHash/dHash Hamming distance for Lookalikes (0-32, default 14)
LOOKALIKE_HAMMING=14
